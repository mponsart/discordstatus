# ---------------------------------------------------------------------------
# Discord Guard — .htaccess admin/
# ---------------------------------------------------------------------------

# Désactiver la liste des répertoires
Options -Indexes

# Interdire l'accès direct aux fichiers autres que les .php autorisés
# (protection contre la lecture de fichiers résiduels)
<FilesMatch "\.(sqlite|db|json|log|bak|tmp|sql|env|sh|pem|key|crt)$">
    Require all denied
</FilesMatch>

# Anti-cache strict pour toutes les pages admin
<IfModule mod_headers.c>
    Header always set Cache-Control "no-store, no-cache, must-revalidate, private, max-age=0"
    Header always set Pragma         "no-cache"
    Header always set Expires        "Thu, 01 Jan 1970 00:00:00 GMT"
    Header always unset ETag
</IfModule>

# Bloquer les requêtes TRACE/TRACK (prévention XST)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)
    RewriteRule .* - [F,L]
</IfModule>
